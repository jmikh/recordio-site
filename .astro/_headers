# Hashed build assets: safe to cache for a year, the filename changes on every build.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts and feature videos change rarely and are not hashed; one week is a safe middle ground.
/fonts/*
  Cache-Control: public, max-age=604800
/videos/*
  Cache-Control: public, max-age=604800

# HTML: always revalidate so deploys show up immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/*/
  Cache-Control: public, max-age=0, must-revalidate

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-0.xml
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8
