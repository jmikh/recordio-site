---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LoomAlternativesArticle from "../../components/blog/LoomAlternativesArticle";
import Footer from "../../components/Footer";
import { SITE_URL } from "../../utils/constants";

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Best Loom Alternatives in 2026: Why Teams Are Switching",
    "description": "Looking for a Loom alternative? See why teams are switching to Recordio for studio-quality recordings, shareable links with view analytics, and a free plan with no credit card.",
    "datePublished": "2026-03-05",
    "dateModified": "2026-09-15",
    "author": {
        "@type": "Person",
        "name": "John Mikhail",
        "jobTitle": "Founder of Recordio",
        "url": "https://www.linkedin.com/in/john-mikhail/",
        "description": "MIT grad, previously at Google and Mixpanel, tech and AI enthusiast"
    },
    "image": `${SITE_URL}/og-image.png`,
    "publisher": {
        "@type": "Organization",
        "name": "Recordio",
        "url": SITE_URL,
        "logo": {
            "@type": "ImageObject",
            "url": `${SITE_URL}/assets/fulllogo-light.png`
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `${SITE_URL}/blog/best-loom-alternatives-2026/`
    }
});
---

<BaseLayout
    title="Best Loom Alternatives in 2026 for Teams | Recordio"
    description="Loom alternatives in 2026: what Loom costs per seat, where its videos fall short, and how Recordio and Screen Studio compare on features and price."
    ogType="article"
>
    <main class="pt-12 md:pt-20">
        <LoomAlternativesArticle client:load />
    </main>
    <Footer source="blog_best-loom-alternatives-2026" client:visible />
</BaseLayout>

<script type="application/ld+json" set:html={jsonLd} />
