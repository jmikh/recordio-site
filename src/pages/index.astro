---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header";
import Hero from "../components/Hero";
import FeatureVideos from "../components/FeatureVideos";
import FinalCTA from "../components/FinalCTA";
import Testimonials from "../components/Testimonials";
import Pricing from "../components/Pricing";
import FAQ from "../components/FAQ";
import Footer from "../components/Footer";
---

<BaseLayout
    title="Screen Recorder for Product Walkthroughs | Recordio"
    description="Recordio is a cloud screen recorder for teams. Record a product walkthrough, get automatic zoom, spotlight and captions, then share a link. Free plan."
    faqSchema
>
    <Header client:load />
    <main>
        <Hero client:load />
        <FeatureVideos client:visible />
        <Testimonials client:visible />
        <Pricing client:visible />
        <FAQ client:visible />
        <FinalCTA client:visible />
    </main>
    <Footer client:visible />
</BaseLayout>
